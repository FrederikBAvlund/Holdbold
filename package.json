{
  "name": "holdbold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @holdbold/api",
    "build": "npm run build -w @holdbold/api",
    "start": "npm run start -w @holdbold/api",
    "lint": "npm run lint -w @holdbold/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch -w @holdbold/api",
    "prisma:validate": "npm run prisma:validate -w @holdbold/api",
    "prisma:generate": "npm run prisma:generate -w @holdbold/api",
    "prisma:migrate": "npm run prisma:migrate -w @holdbold/api",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy -w @holdbold/api",
    "prisma:studio": "npm run prisma:studio -w @holdbold/api",
    "prisma:seed": "npm run prisma:seed -w @holdbold/api",
    "db:up": "docker compose up -d --wait db",
    "db:reset": "npm run db:reset -w @holdbold/api",
    "dev:setup": "npm run dev:setup -w @holdbold/api"
  }
}
