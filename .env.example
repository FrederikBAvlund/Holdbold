DATABASE_URL="postgresql://user:password@localhost:5432/holdbold"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-me"
DIRECT_URL="postgresql://user:password@localhost:5432/holdbold"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PROFILE_BUCKET="profile-images"
# Optional absolute path for private, persistent profile images on Hetzner.
# Leave empty on Vercel. Takes precedence over Supabase Storage.
LOCAL_PROFILE_UPLOAD_DIR=""
AUTH_CREDENTIALS_ENABLED="true"
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:tech@holdbold.dk"
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=""
SEED_TEAM_SLUG="hold-1"
SEED_TEAM_NAME="Hold 1"
# Kun lokalt: opretter testbrugere til alle roller (admin@, traener@, boedekasse@, spiller@ …@holdbold.local) med dette kodeord.
# Seed'en afviser at køre, hvis DATABASE_URL ikke peger på denne maskine. Fjern linjen for ikke at oprette dem.
SEED_DEV_PASSWORD="1"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_PLAYER_EMAIL=""
SEED_PLAYER_PASSWORD=""
SEED_INCLUDE_SINGLE_PLAYER="false"
SEED_INCLUDE_DEMO_PLAYERS="false"
SEED_INCLUDE_DEMO_TREASURERS="false"
CRON_SECRET=""
# Coolify: use local Scheduled Tasks, with HTTP cron disabled.
DISABLE_HTTP_CRON="false"
# Enable on Coolify to migrate the new image before app startup.
RUN_DATABASE_MIGRATIONS="false"
# 32 random bytes in hex; keep outside the database and never expose to the client.
TEAM_API_KEY_ENCRYPTION_KEY=""
# Mail til engangskoder og "Glemt adgangskode" (resend.com). Uden nøgle logges mailen kun i konsollen i udvikling.
# MAIL_FROM skal bruge et domæne, der er bekræftet hos Resend, for at kunne sende til alle.
RESEND_API_KEY=""
MAIL_FROM="Holdbold <onboarding@resend.dev>"
# Kommaseparerede e-mails med adgang til admin-panelet (opret/styr alle hold). Standard: frederikavlund@gmail.com
SUPER_ADMIN_EMAILS="frederikavlund@gmail.com"
